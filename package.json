{
  "name": "Moliya AI",
  "private": true,
  "version": "3.22.0",

  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "tsc --noEmit",
    "test": "tsx tests/auth_suite.ts",
    "start": "node dist/server.cjs",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:build:android": "vite build && cap sync android",
    "build:apk": "npm test && npm run cap:build:android && cd android && gradlew assembleDebug",
    "build:aab": "npm test && npm run cap:build:android && cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.12.0",
    "@supabase/supabase-js": "^2.112.3",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
