{
  "version": 2,
  "rewrites": [
    { "source": "/api/telegram-webhook", "destination": "/api/telegram-webhook" },
    { "source": "/api/admin/:route*", "destination": "/api/admin?route=:route*" },
    { "source": "/api/auth/:action*", "destination": "/api/auth?action=:action*" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
