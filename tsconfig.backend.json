{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "server.ts"]
}
