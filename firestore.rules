rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId.matches("^moliya_user_.*");

      match /{document=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || userId.matches("^moliya_user_.*");
      }
    }
    
    match /users_mapping/{mappingId} {
      allow read, write: if false;
    }
  }
}
