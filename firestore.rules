rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId.matches("^moliya_user_.*") || userId.matches("^tg_user_.*");

      match /{document=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || userId.matches("^moliya_user_.*") || userId.matches("^tg_user_.*");
      }
    }

    match /login_requests/{requestId} {
      allow read, write: if true;
    }

    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    match /users_mapping/{mappingId} {
      allow read, write: if false;
    }
  }
}
